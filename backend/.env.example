# Copy to .env and fill in. Never commit .env (hackathon Rule 13).
#
# Reachly runs with NO keys at all when DEMO_MODE=true — every external call is
# served from recorded fixtures. That is the path judges use.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------

# Serve all external calls from fixtures. No API keys required.
DEMO_MODE=true

# Local Postgres from docker-compose.yml (host port 55432 avoids collisions).
DATABASE_URL=postgresql+asyncpg://reachly:reachly_dev_only@localhost:55432/reachly

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-me-with-a-random-48-byte-urlsafe-string
JWT_EXPIRE_MINUTES=10080

# Protects POST /internal/cron/* — see ADR 0007. Same generation command.
CRON_SECRET=replace-me-too

# ---------------------------------------------------------------------------
# Inference — only needed when DEMO_MODE=false (ADR 0002)
# ---------------------------------------------------------------------------

# Kiro built this project; it does not run inside it. Reachly needs its own
# provider. Gemini's free tier needs no credit card.
# Get one at https://aistudio.google.com/apikey
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---------------------------------------------------------------------------
# Job sources — all optional; the app degrades to whatever is configured
# ---------------------------------------------------------------------------

# Greenhouse, Lever, Ashby and The Muse need NO key. Nothing to set here.

# JSearch via RapidAPI. Free tier is ~200 requests/MONTH, so results are cached
# in Postgres and this is never called on a page render (ADR 0005).
RAPIDAPI_KEY=

# ---------------------------------------------------------------------------
# Contact discovery — the waterfall in ADR 0004
# ---------------------------------------------------------------------------

# Tried in order of free allowance; the first hit wins. All optional.
HUNTER_API_KEY=          # 50 credits/month, supports department=hr
PROSPEO_API_KEY=         # ~100 credits/month
TOMBA_API_KEY=           # 25-75 searches/month
TOMBA_API_SECRET=

# Verifies pattern-inferred addresses. 1,000 free verifications/month — the
# largest free allowance in the stack, so this carries most of the traffic.
MAILBOXLAYER_API_KEY=

# ---------------------------------------------------------------------------
# Ops
# ---------------------------------------------------------------------------

CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
